#<src>                                            <mnt_point>           <type>  <mnt_flags and options>                                                                                         <fs_mgr_flags>
system                                             /system              ext4    ro                                                                                                              wait,avb=vbmeta_system,logical,first_stage_mount
system_ext                                         /system_ext          ext4    ro                                                                                                              wait,avb=vbmeta_system,logical,first_stage_mount
vendor                                             /vendor              ext4    ro                                                                                                              wait,avb,logical,first_stage_mount
product                                            /product             ext4    ro                                                                                                              wait,avb,logical,first_stage_mount
odm                                                /odm                 ext4    ro                                                                                                              wait,avb,logical,first_stage_mount
system                                             /system              erofs   ro                                                                                                              wait,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system_ext                                         /system_ext          erofs   ro                                                                                                              wait,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
vendor                                             /vendor              erofs   ro                                                                                                              wait,avb,logical,first_stage_mount
product                                            /product             erofs   ro                                                                                                              wait,avb,logical,first_stage_mount
odm                                                /odm                 erofs   ro                                                                                                              wait,logical,first_stage_mount,nofail

my_product /my_product ext4 ro wait,logical,first_stage_mount,nofail
my_product /my_product erofs ro wait,logical,first_stage_mount,nofail
my_engineering /my_engineering ext4 ro wait,logical,first_stage_mount,nofail
my_engineering /my_engineering erofs ro wait,logical,first_stage_mount,nofail
my_company /my_company ext4 ro,barrier=1 wait,logical,first_stage_mount,nofail
my_company /my_company erofs ro,barrier=1 wait,logical,first_stage_mount,nofail
my_carrier /my_carrier ext4 ro,barrier=1 wait,logical,first_stage_mount,nofail
my_carrier /my_carrier erofs ro,barrier=1 wait,logical,first_stage_mount,nofail
my_region /my_region ext4 ro,barrier=1 wait,logical,first_stage_mount,nofail
my_region /my_region erofs ro,barrier=1 wait,logical,first_stage_mount,nofail
my_heytap /my_heytap ext4 ro,barrier=1 wait,logical,first_stage_mount,nofail
my_heytap /my_heytap erofs ro,barrier=1 wait,logical,first_stage_mount,nofail
my_stock /my_stock ext4 ro,barrier=1 wait,logical,first_stage_mount,nofail
my_stock /my_stock erofs ro,barrier=1 wait,logical,first_stage_mount,nofail
my_preload /my_preload ext4 ro wait,logical,first_stage_mount,nofail
my_preload /my_preload erofs ro wait,logical,first_stage_mount,nofail
my_bigball /my_bigball ext4 ro wait,logical,first_stage_mount,nofail
my_bigball /my_bigball erofs ro wait,logical,first_stage_mount,nofail

/dev/block/by-name/md_udc                          /metadata            ext4    noatime,nosuid,nodev,discard                                                                                    wait,formattable,first_stage_mount
/dev/block/by-name/cache                           /cache               ext4    noatime,nosuid,nodev,noauto_da_alloc,discard                                                                     wait,check,formattable
/dev/block/by-name/userdata                        /data                f2fs    noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt     wait,check,formattable,quota,reservedsize=128m,latemount,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v1
/dev/block/by-name/misc                            /misc                emmc    defaults                                                                                                        defaults
/dev/block/by-name/persist                         /mnt/vendor/persist  ext4    noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc                                                        wait,check,formattable
