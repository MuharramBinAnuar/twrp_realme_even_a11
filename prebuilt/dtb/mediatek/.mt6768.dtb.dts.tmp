# 3830 "../arch/arm64/boot/dts/mediatek/mt6768.dts" 2
# 1 "../arch/arm64/boot/dts/mediatek/cust_mt6768_msdc.dtsi" 1
# 15 "../arch/arm64/boot/dts/mediatek/cust_mt6768_msdc.dtsi"
&msdc0 {
 index = /bits/ 8 <0>;
 clk_src = /bits/ 8 <(1)>;
 bus-width = <8>;
 max-frequency = <200000000>;
 cap-mmc-highspeed;
 mmc-ddr-1_8v;
 mmc-hs200-1_8v;
 mmc-hs400-1_8v;
 no-sd;
 no-sdio;
 non-removable;
 pinctl = <&msdc0_pins_default>;
 pinctl_hs400 = <&msdc0_pins_hs400>;
 pinctl_hs200 = <&msdc0_pins_hs200>;
 register_setting = <&msdc0_register_setting_default>;
 host_function = /bits/ 8 <(0)>;
 bootable;
 status = "okay";


 vmmc-supply = <&mt_pmic_vemc_ldo_reg>;
 clocks = <&infracfg_ao 76>,
  <&infracfg_ao 28>,
  <&infracfg_ao 68>;
