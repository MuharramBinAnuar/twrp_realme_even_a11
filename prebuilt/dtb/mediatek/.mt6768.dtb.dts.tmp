/ {
 sia81xx_L: sia81xx@L {
  compatible = "si,sia81xx";
  si,sia81xx_type = "sia8101";
  si,sia81xx_reset = <&pio 160 0>;
  si,sia81xx_owi = <&pio 160 0>;
  pinctrl-names = "sia81xx_gpio";
  pinctrl-0 = <&sia81xx_gpio_L>;

