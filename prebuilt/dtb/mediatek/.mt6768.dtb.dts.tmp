      "fg_cur_l";
 };

 pmic_auxadc: mt635x-auxadc {
  compatible = "mediatek,mt6358-auxadc";
  #io-channel-cells = <1>;

  batadc {
   channel = <0x00>;
   resistance-ratio = <3 1>;
   avg-num = <128>;
  };
  vcdt {
   channel = <0x02>;
  };
  bat_temp {
   channel = <0x03>;
   resistance-ratio = <2 1>;
  };
  chip_temp {
   channel = <0x05>;
  };
  vcore_temp {
   channel = <0x06>;
  };
  vproc_temp {
   channel = <0x07>;
  };
  vgpu_temp {
   channel = <0x08>;
  };
  accdet {
   channel = <0x09>;
  };
  dcxo_volt {
   channel = <0x0a>;
   resistance-ratio = <3 2>;
  };
  tsx_temp {
   channel = <0x0b>;
   avg-num = <128>;
  };
  hpofs_cal {
   channel = <0x0c>;
   avg-num = <256>;
  };
  dcxo_temp {
   channel = <0x0d>;
   avg-num = <16>;
  };
  vbif {
   channel = <0x0e>;
   resistance-ratio = <2 1>;
  };
 };

